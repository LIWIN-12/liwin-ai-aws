# Required for Gemini embeddings and the default text-generation provider.
GEMINI_API_KEY=

# Current model settings. Change only after testing the selected model with your key.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-3.8-flash

# Gemini is tried first. The optional fallbacks below improve availability but
# receive the assembled portfolio prompt when Gemini is unavailable.
LLM_PROVIDERS=gemini,openrouter,groq
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated origins for a separately hosted frontend. Same-origin requests
# need no CORS entry.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Persistent paths. Use /var/data for a Render persistent disk.
# CHROMA_PATH=/var/data/chroma_db
# MEMORY_DB_PATH=/var/data/liwin_memory.db

MEMORY_MAX_MESSAGES=10
MEMORY_RETENTION_DAYS=30
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONTEXT_CHARACTERS=8000
